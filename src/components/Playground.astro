---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { documents } from '../lib/playground-model';
import { href } from '../data/site';
const apps = [
  { id: 'editor', name: 'Editor' },
  { id: 'files', name: 'Files' },
  { id: 'settings', name: 'Appearance' },
  { id: 'inspector', name: 'Inspector' },
];
---

<section
  id="playground"
  class="playground"
  aria-label="Interactive desktop concept"
  data-theme="midnight"
>
  <div class="playground-heading">
    <span>
      <span class="status-dot"></span>Interactive concept — simulated in your browser.
    </span>
    <span class="micro">NO OS CONNECTION</span>
  </div>
  <div class="playground-toolbar">
    <div class="playground-tabs" aria-label="Open an application">
      {apps.map((app) => (
        <button data-open={app.id}>
          <Icon name={app.id} />
          {app.name}
        </button>
      ))}
    </div>
    <div class="playground-utilities">
      <button data-palette-open>
        <Icon name="search" size={17} />
        Actions
      </button>
      <button data-reset>
        <Icon name="reset" size={17} />
        Reset<span class="sr-only"> workspace and discard edits</span>
      </button>
    </div>
  </div>
  <noscript>
    <p class="noscript-note">
      Enable JavaScript to use the desktop concept. The guided scenarios and engineering
      explanations below remain readable without it.
    </p>
  </noscript>
  <div class="desktop-workspace" id="desktop-workspace">
    <div class="desktop-menubar">
      <span class="desktop-wordmark">
        <Mark /> CONTINUUM <span class="menu-divider">/</span>
        <span id="active-app-label">Editor</span>
      </span>
      <span class="micro">WORKSPACE 01 · BROWSER CONCEPT</span>
    </div>
    <img
      class="desktop-wallpaper-art"
      src={href('images/continuity-wallpaper.webp')}
      alt=""
      width="1672"
      height="941"
      decoding="async"
    />
    <div class="desktop-wallpaper-line" aria-hidden="true"></div>
    <div class="desktop-empty" hidden>
      <Mark />
      <p>Your workspace, at your pace.</p>
      <small>Open an app from the toolbar or dock.</small>
    </div>
    <div id="snap-preview" class="snap-preview" hidden aria-hidden="true"></div>
    {apps.map((app) => (
      <section
        class:list={['demo-window', `window-${app.id}`]}
        data-window={app.id}
        role="region"
        aria-label={`${app.name} window`}
        hidden={app.id === 'files' || app.id === 'inspector'}
      >
        <div class="demo-titlebar" data-drag={app.id}>
          <span>
            <Icon name={app.id} size={17} />
            <span>{app.name}</span>
          </span>
          <div class="window-controls">
            {app.id !== 'editor' && (
              <select
                class="window-position"
                data-position-app={app.id}
                aria-label={`${app.name} window position`}
              >
                <option value="">Position</option>
                <option value="left">Left</option>
                <option value="center">Center</option>
                <option value="right">Right</option>
              </select>
            )}
            <button data-minimize={app.id} aria-label={`Minimize ${app.name}`}>
              <Icon name="minimize" size={17} />
            </button>
            <button data-maximize={app.id} aria-label={`Maximize ${app.name}`}>
              <Icon name="maximize" size={16} />
            </button>
          </div>
        </div>
        {app.id === 'editor' && (
          <>
            <div class="editor-toolbar">
              <span id="editor-file-name">Field notes.md</span>
              <span class="editor-generation">
                DEMO GEN <b id="editor-generation">1</b>
              </span>
              <label class="position-label">
                <span class="sr-only">Editor window position</span>
                <select id="editor-position" aria-label="Editor window position">
                  <option value="">Position</option>
                  <option value="left">Left</option>
                  <option value="center">Center</option>
                  <option value="right">Right</option>
                </select>
              </label>
            </div>
            <div class="editor-content">
              <div class="editor-gutter" aria-hidden="true">
                01
                <br />
                02
                <br />
                03
                <br />
                04
                <br />
                05
                <br />
                06
                <br />
                07
                <br />
                08
                <br />
                09
                <br />
                10
                <br />
                11
                <br />
                12
                <br />
                13
                <br />
                14
                <br />
                15
              </div>
              <textarea
                id="demo-editor"
                aria-label="Concept document editor"
                spellcheck="false"
                aria-describedby="editor-memory-note"
              >{documents['Field notes.md']}</textarea>
            </div>
            <div class="editor-bottom">
              <span id="document-dirty">Bundled sample · memory only</span>
              <span id="word-count" hidden></span>
              <span id="selection-label">No selection</span>
            </div>
            <p id="editor-memory-note">
              Edits stay on this page. Refresh or leaving discards them.
            </p>
          </>
        )}
        {app.id === 'files' && (
          <div class="files-content">
            <span class="micro">BUNDLED EXAMPLES / IN MEMORY</span>
            <h3>A place for ideas.</h3>
            <p>Open a thread. Keep your own edits until you choose to discard them.</p>
            <div class="file-list">
              {Object.keys(documents).map((file) => (
                <button data-file={file}>
                  <Icon name="editor" size={25} />
                  <span>
                    {file}
                    <small>Markdown · bundled sample</small>
                  </span>
                  <Icon name="arrow" size={15} />
                </button>
              ))}
            </div>
            <p class="files-note">These are sample strings, not files on your computer.</p>
          </div>
        )}
        {app.id === 'settings' && (
          <div class="appearance-content">
            <span class="micro">A QUIETER KIND OF DESKTOP</span>
            <h3>Find your atmosphere.</h3>
            <p>Same workspace. A different light.</p>
            <div class="theme-options" aria-label="Appearance theme">
              {['midnight', 'dusk', 'copper'].map((theme) => (
                <button
                  data-theme-choice={theme}
                  aria-pressed={theme === 'midnight' ? 'true' : 'false'}
                >
                  <i class:list={['theme-swatch', theme]}></i>
                  <span>{theme[0].toUpperCase() + theme.slice(1)}</span>
                </button>
              ))}
            </div>
            <div class="appearance-detail">
              <span>Surface</span>
              <span id="theme-label">Midnight</span>
            </div>
            <div class="appearance-detail">
              <span>Motion</span>
              <span>Purposeful</span>
            </div>
            <div class="appearance-preserved">
              <Icon name="check" />
              <p>
                A new appearance.
                <br />
                <b>The same place.</b>
              </p>
            </div>
            <span class="micro">CONCEPT TOKENS / NOT A FINAL OS SKIN</span>
          </div>
        )}
        {app.id === 'inspector' && (
          <div class="inspector-content">
            <span class="micro">ILLUSTRATIVE ACTION LOG</span>
            <p class="inspector-intro">
              Buttons and the palette share one typed dispatcher. These results describe browser
              state only.
            </p>
            <ol id="action-log"></ol>
          </div>
        )}
      </section>
    ))}
    <div class="desktop-dock" aria-label="Desktop dock">
      <button data-launcher aria-label="Open application launcher" aria-expanded="false">
        <Mark />
      </button>
      <span class="dock-divider"></span>
      {apps.map((app) => (
        <button
          data-open={app.id}
          aria-label={`Open ${app.name}`}
          aria-describedby={`tooltip-${app.id}`}
        >
          <Icon name={app.id} size={23} />
          <i data-dock-indicator={app.id}></i>
          <span class="tooltip" role="tooltip" id={`tooltip-${app.id}`}>
            {app.name}
          </span>
        </button>
      ))}
    </div>
    <div class="launcher-panel" id="launcher" hidden>
      <span class="micro">YOUR WORKSPACE</span>
      <h3>Pick up a thread.</h3>
      <div>
        {apps.map((app) => (
          <button data-open={app.id}>
            <Icon name={app.id} />
            {app.name}
            <Icon name="arrow" size={15} />
          </button>
        ))}
      </div>
      <button class="launcher-actions" data-palette-open>
        Browse all typed actions <Icon name="arrow" size={14} />
      </button>
    </div>
    <span class="desktop-concept-tag">CONCEPT SCENE / ALL EVENTS SIMULATED</span>
  </div>
  <div class="simulation-status" id="simulation-status">
    <div class="result-message">
      <span data-run-icon="completed" hidden>
        <Icon name="check" />
      </span>
      <span data-run-icon="rejected" hidden>
        <Icon name="warning" />
      </span>
      <span id="demo-status" role="status">
        Ready. Write a little, select some text, then try an update below.
      </span>
    </div>
    <button data-open="inspector">
      Inspect actions <Icon name="arrow" size={13} />
    </button>
    <div class="run-progress" id="run-progress" hidden>
      <div
        class="run-meter"
        role="progressbar"
        aria-label="Simulated update progress"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <span></span>
      </div>
      <span id="run-phase" role="status"></span>
      <button id="finish-update">Finish now</button>
    </div>
  </div>
  <dialog id="command-palette" aria-labelledby="palette-title">
    <div class="palette-heading">
      <h2 id="palette-title">What’s next?</h2>
      <button id="palette-close" aria-label="Close action palette">
        <Icon name="close" />
      </button>
    </div>
    <label for="command-search" class="sr-only">
      Search demo actions
    </label>
    <input
      id="command-search"
      type="search"
      placeholder="Find a typed action…"
      autocomplete="off"
      aria-describedby="command-count"
    />
    <div class="command-count" id="command-count" role="status"></div>
    <div id="command-results" class="command-results"></div>
    <p class="palette-hint">
      ↑ ↓ to navigate · Enter to run · Esc to close
      <br />
      Ctrl / ⌘ K inside the workspace
    </p>
  </dialog>
  <dialog
    id="discard-dialog"
    aria-labelledby="discard-title"
    aria-describedby="discard-description"
  >
    <div class="discard-content">
      <span class="micro">YOUR WORK, YOUR CHOICE</span>
      <h2 id="discard-title">Keep this thread?</h2>
      <p id="discard-description">
        Your document has in-memory edits. Continuing will discard them.
      </p>
      <div class="discard-actions">
        <button id="discard-keep" autofocus>
          Keep editing
        </button>
        <button data-discard-confirm>Discard & continue</button>
      </div>
    </div>
  </dialog>
</section>
<script>
  import '../scripts/playground';
</script>
