---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { href } from '../data/site';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class="hero-preview-shell" data-hero-scene data-theme="midnight">
  <div class="hero-preview-controls" aria-label="Concept illustration appearance">
    <div>
      {(['midnight', 'dusk', 'copper'] as const).map((theme) => (
        <button
          data-hero-theme={theme}
          aria-pressed={theme === 'midnight' ? 'true' : 'false'}
          disabled
        >
          <i class={theme}></i>
          {theme[0].toUpperCase() + theme.slice(1)}
        </button>
      ))}
    </div>
    <button data-hero-play disabled>
      <Icon name="play" size={15} /> Play continuity
    </button>
  </div>
  <div
    class:list={['desktop-preview', { compact }]}
    role="img"
    aria-label="Concept illustration of an editor, appearance settings and a preserved document; not an OS screenshot"
  >
    <img
      class="preview-wallpaper"
      src={href('images/continuity-wallpaper.webp')}
      alt=""
      width="1672"
      height="941"
      decoding="async"
      fetchpriority="high"
    />
    <div class="preview-top">
      <span>
        <Mark /> CONTINUUM
      </span>
      <span>
        Workspace 01 <span class="preview-dot">●</span>
      </span>
    </div>
    <div class="wallpaper-mark">
      c<span>↗</span>
    </div>
    <div class="preview-orbit orbit-one"></div>
    <div class="preview-orbit orbit-two"></div>
    <div class="preview-editor">
      <div class="mini-title">
        <span>
          <Icon name="editor" size={12} /> Field notes <span class="file-ext">.md</span>
        </span>
        <span class="window-dots">
          <Icon name="minimize" size={9} /> <Icon name="maximize" size={9} />{' '}
          <Icon name="close" size={9} />
        </span>
      </div>
      <div class="preview-editor-body">
        <div class="preview-sidebar">
          <span class="micro">WORKSPACE</span>
          <span class="selected">
            <Icon name="editor" size={10} /> Field notes
          </span>
          <span>
            <Icon name="editor" size={10} /> Next steps
          </span>
          <span>
            <Icon name="files" size={10} /> References
          </span>
          <span class="sidebar-bottom">01 / PERSONAL</span>
        </div>
        <div class="preview-document">
          <span class="micro">A LITTLE ROOM TO THINK</span>
          <h3>
            Make space
            <br />
            for what’s next.
          </h3>
          <p>
            A system should evolve around your work.
            <br />
            Not ask you to start again.
          </p>
          <div class="preview-code">
            <span>01</span> Keep the document.
            <br />
            <span>02</span> Change the system.
            <br />
            <span>03</span> <b>Continue.</b>
            <i></i>
          </div>
        </div>
      </div>
      <div class="preview-status">
        <span>
          Markdown <b>·</b> Unsaved changes
        </span>
        <span>UTF-8 &nbsp; Ln 3, Col 10</span>
      </div>
    </div>
    <div class="preview-settings">
      <div class="mini-title">
        <span>
          <Icon name="settings" size={10} /> Appearance
        </span>
        <span>
          <Icon name="minimize" size={9} /> <Icon name="close" size={9} />
        </span>
      </div>
      <div class="settings-body">
        <span class="micro">A QUIETER KIND OF DESKTOP</span>
        <h4>Considered, by default.</h4>
        <div class="swatches">
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </div>
        <div class="setting-row">
          Surface <span data-hero-surface>Midnight</span>
        </div>
        <div class="setting-row">
          Motion <span>Purposeful</span>
        </div>
        <div class="preview-commit">
          <span>✓</span>
          <div>
            New appearance. Same place.<small>State preserved · concept illustration</small>
          </div>
        </div>
      </div>
    </div>
    <div class="preview-dock">
      <Mark />
      <Icon name="editor" />
      <Icon name="files" />
      <Icon name="settings" />
      <Icon name="inspector" />
      <i></i>
      <span class="dock-caption">A continuous workspace</span>
    </div>
    <span class="concept-caption">BROWSER CONCEPT / NOT AN OS SCREENSHOT</span>
  </div>
  <p class="hero-preview-status" data-hero-status role="status">
    A design exploration. Your work is the constant.
  </p>
</div>
<script>
  import '../scripts/hero';
</script>
